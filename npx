#!/bin/bash
# NPX wrapper - uses the node wrapper for version management

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Get the node binary path from our node wrapper
node_path=$("$SCRIPT_DIR/node" -e "console.log(process.execPath)" 2>/dev/null)
node_dir=$(dirname "$node_path")

# Execute npx from the same Node installation
exec "$node_dir/npx" "$@"
